{
  "serviceName": "Toolstack jobs",
  "serviceId": "ed4f7cb9-5ee6-4ef3-a14e-e45d19021875",
  "projectId": "bbbe0a8e-81f7-41b9-9d64-76a38ad7d8fb",
  "environmentId": "1ff52f6b-2c4d-4a5d-835d-fe90506420d2",
  "source": {
    "repo": "lostprojects/toolstack",
    "branch": "deploy"
  },
  "settings": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "numReplicas": 1,
    "drainingSeconds": 30,
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/package.json",
      "/package-lock.json",
      "/deployment/railway/jobs.*",
      "/Dockerfile",
      "/.dockerignore",
      "/api/package.json",
      "/api/tsconfig*.json",
      "/api/scripts/package-gateway.mjs",
      "/api/src/services/jobs/**",
      "/api/src/services/library/**",
      "/api/src/services/shared-store.ts",
      "/api/src/services/organization.ts",
      "/api/src/services/gateway-principal.ts",
      "/api/src/load-env.ts",
      "/api/src/utils/public-error.ts",
      "/api/src/utils/content-disposition.ts"
    ],
    "builder": "RAILPACK",
    "buildCommand": null,
    "startCommand": null,
    "rootDirectory": null,
    "railwayConfigFile": null
  },
  "variables": {
    "PORT": "8080",
    "STEEL_IMAGE": "jobs",
    "STEEL_ROLE": "executor"
  }
}
