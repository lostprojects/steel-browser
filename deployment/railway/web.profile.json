{
  "serviceName": "Toolstack web",
  "serviceId": "6887ca43-4e21-40d6-a411-fd29c0c09039",
  "projectId": "bbbe0a8e-81f7-41b9-9d64-76a38ad7d8fb",
  "environmentId": "1ff52f6b-2c4d-4a5d-835d-fe90506420d2",
  "source": {
    "repo": "lostprojects/toolstack",
    "branch": "deploy"
  },
  "settings": {
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "numReplicas": 1,
    "drainingSeconds": 30,
    "dockerfilePath": "deployment/railway/web.Dockerfile",
    "watchPatterns": [
      "/package.json",
      "/package-lock.json",
      "/deployment/railway/web.*",
      "/ui/**",
      "/.dockerignore"
    ],
    "builder": "RAILPACK",
    "buildCommand": "",
    "startCommand": "caddy run --config /etc/caddy/Caddyfile --adapter caddyfile",
    "rootDirectory": null,
    "railwayConfigFile": null
  },
  "variables": {
    "PORT": "8080"
  }
}
