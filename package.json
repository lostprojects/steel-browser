{
  "name": "toolstack",
  "version": "0.5.3",
  "private": true,
  "license": "Apache-2.0",
  "author": "",
  "type": "module",
  "workspaces": [
    "api",
    "ui",
    "repl"
  ],
  "scripts": {
    "build": "npm run build -w api -w ui",
    "dev": "concurrently \"npm run dev -w api\" \"npm run dev -w ui\"",
    "test": "npm run test -w api",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "lint-staged": "^16.4.0",
    "husky": "^9.1.7"
  },
  "lint-staged": {
    "api/src/**/*.ts": "prettier --write",
    "ui/src/**/*.{ts,tsx,css}": "prettier --write"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "tar-fs": ">=3.1.1",
    "tar": "^7.5.22",
    "basic-ftp": "^6.2.3",
    "readdir-glob": {
      "minimatch": "^11.0.1"
    }
  }
}
