# Local API development. Copy to api/.env; run npm run dev -w api.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
USE_SSL=false
STEEL_API_KEY=replace-with-a-local-secret
# DOMAIN=localhost:3000
# CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

# Match production browser settings. Quiet mode needs Linux X11 tools;
# use the root Docker Compose setup for quiet-mode development.
CHROME_HEADLESS=false
CAPTURE_CONSOLE_EVENTS=false
ENABLE_PDF_VIEWER=true
ENABLE_COMMANDS_API=true
MAX_SESSIONS=3
PROFILES_ROOT=/tmp/steel-local-profiles
# DEFAULT_TIMEZONE=America/New_York

# Proxy URL and timezone belong in each session's creation request.
# TIMEZONE_SERVICE_URL=https://ipinfo.io/json
# PROXY_INTERNAL_BYPASS=localhost,127.0.0.1
LOG_LEVEL=warn
ENABLE_VERBOSE_LOGGING=false
