# Local API development. Copy to api/.env; run npm run dev -w api.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
USE_SSL=false
STEEL_API_KEY=replace-with-a-local-secret
DOMAIN=localhost:5173
# Production requires the organization's persisted UUID. Local source/Compose
# development uses a fixed development organization when this is omitted.
# TOOLSTACK_ORG_ID=your-organization-uuid
# TOOLSTACK_ORG_NAME=My organization
# CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
# FETCH_PYTHON=/absolute/path/to/Toolstack/api/.venv/bin/python

# Match production browser settings. Quiet mode needs Linux X11 tools;
# use the root Docker Compose setup for quiet-mode development.
CHROME_HEADLESS=false
CAPTURE_CONSOLE_EVENTS=false
ENABLE_PDF_VIEWER=true
ENABLE_COMMANDS_API=true
MAX_SESSIONS=3
# HTTP admission defaults to CPU/memory budgets. Optional worker overrides:
# MAX_HTTP_FETCHES=16
# HTTP_MEMORY_BUDGET_MB=1024
PROFILES_ROOT=/tmp/toolstack-local-profiles
# FILES_ROOT=/tmp/toolstack-local-files
# DOWNLOAD_MAX_BYTES=536870912
# DOWNLOAD_PENDING_BYTES=1073741824
# DOWNLOAD_HANDOFF_BYTES=2147483648
# DEFAULT_TIMEZONE=America/New_York

# Managed proxy leases verify their exit and timezone before browser startup.
# Consumption credentials: EVOMI_RESIDENTIAL_PROXY_URL, EVOMI_PREMIUM_PROXY_URL,
# EVOMI_MOBILE_PROXY_URL, EVOMI_DATACENTER_PROXY_URL. Keep actual values in env.
# Custom profiles reference TOOLSTACK_PROXY_* authenticated gateway URLs.
LOG_LEVEL=warn

# Team mode requires a separate gateway and runtime/volume per person. Use
# npm run team -w repl -- help to generate private configuration; see TEAM.md.
# STEEL_ROLE=standalone

# Optional central content library. Configure all six together on the gateway
# or standalone owner service; private workers use STEEL_SHARED_URL/KEY instead.
# Use a dedicated Toolstack database, separate from PMS. See LIBRARY.md.
# TOOLSTACK_DATABASE_URL=postgres://toolstack_app:replace@localhost:5432/toolstack
# TOOLSTACK_WASABI_BUCKET=your-private-toolstack-bucket
# TOOLSTACK_WASABI_REGION=us-east-1
# TOOLSTACK_WASABI_ACCESS_KEY=replace-with-bucket-scoped-key
# TOOLSTACK_WASABI_SECRET_KEY=replace-with-matching-secret
# TOOLSTACK_CONTENT_KEY=replace-with-64-hex-characters
