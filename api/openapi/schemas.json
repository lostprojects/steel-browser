      "SessionDetails": {
        "title": "SessionDetails",
        "type": "object",
        "properties": {
          "deliveryVersion": {
            "description": "Verified binary delivery protocol supported by this session",
            "type": "number",
            "enum": [
              1
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "Unique identifier for the session"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "description": "Timestamp when the session started"
          },
          "status": {
            "type": "string",
            "enum": [
              "starting",
              "live",
              "released",
              "failed"
            ],
            "description": "Status of the session"
          },
          "mode": {
            "type": "string",
            "enum": [
              "agent",
              "quiet"
            ]
          },
          "browserCapabilities": {
            "type": "object",
            "properties": {
              "input": {
                "type": "string",
                "enum": [
                  "native",
                  "cdp"
                ]
              },
              "capture": {
                "type": "string",
                "enum": [
                  "display",
                  "page"
                ]
              },
              "fullPageCapture": {
                "type": "boolean"
              },
              "elementCapture": {
                "type": "boolean"
              },
              "captureQuality": {
                "type": "boolean"
              },
              "pdf": {
                "type": "boolean"
              },
              "networkIdle": {
                "type": "boolean"
              }
            },
            "required": [
              "input",
              "capture",
              "fullPageCapture",
              "elementCapture",
              "captureQuality",
              "pdf",
              "networkIdle"
            ],
            "description": "Browser operations supported before command execution",
            "additionalProperties": false
          },
          "identity": {
            "description": "Named persistent profile, when requested",
            "type": "string"
          },
          "proxyLeaseId": {
            "description": "Managed proxy lease; contains no provider credentials",
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "site": {
            "type": "string"
          },
          "caller": {
            "type": "string"
          },
          "last_login_ok": {
            "type": "string"
          },
          "viewAvailable": {
            "type": "boolean",
            "description": "Whether this identity permits a live browser view"
          },
          "exit": {
            "type": "object",
            "properties": {
              "ip": {
                "type": "string"
              },
              "timezone": {
                "type": "string"
              },
              "country": {
                "type": "string"
              },
              "region": {
                "type": "string"
              }
            },
            "required": [
              "ip",
              "timezone",
              "country",
              "region"
            ],
            "additionalProperties": false
          },
          "challenge": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "status",
              "kind",
              "url"
            ],
            "additionalProperties": false
          },
          "directBytes": {
            "type": "number",
            "minimum": 0
          },
          "endReason": {
            "type": "string"
          },
          "temporaryProfileRemoved": {
            "type": "boolean"
          },
          "duration": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Duration of the session in milliseconds"
          },
          "eventCount": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Legacy compatibility field; use /v1/logs/stats for event counts"
          },
          "dimensions": {
            "type": "object",
            "properties": {
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              }
            },
            "required": [
              "width",
              "height"
            ],
            "description": "Dimensions used for the session",
            "additionalProperties": false
          },
          "timeout": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Session timeout duration in milliseconds"
          },
          "creditsUsed": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Legacy compatibility field; this service meters proxy bytes"
          },
          "websocketUrl": {
            "type": "string",
            "description": "URL for the session's WebSocket connection"
          },
          "debugUrl": {
            "type": "string",
            "description": "URL for a viewing the live browser instance for the session"
          },
          "debuggerUrl": {
            "type": "string",
            "description": "Legacy alias for the session viewer URL"
          },
          "sessionViewerUrl": {
            "type": "string",
            "description": "URL to view session details"
          },
          "noVncUrl": {
            "type": "string",
            "description": "Authenticated live display view"
          },
          "display": {
            "type": "string"
          },
          "commandMethods": {
            "description": "CDP methods used by quiet commands",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "userAgent": {
            "description": "User agent string used in the session",
            "type": "string"
          },
          "proxyTxBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Amount of data transmitted through the proxy"
          },
          "proxyRxBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Amount of data received through the proxy"
          },
          "proxyTraffic": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "hostname": {
                  "type": "string"
                },
                "txBytes": {
                  "type": "number",
                  "minimum": 0
                },
                "rxBytes": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "hostname",
                "txBytes",
                "rxBytes"
              ],
              "additionalProperties": false
            },
            "description": "Proxy bytes by hostname, including open tunnels; no URLs or credentials"
          }
        },
        "required": [
          "id",
          "createdAt",
          "status",
          "mode",
          "browserCapabilities",
          "viewAvailable",
          "directBytes",
          "temporaryProfileRemoved",
          "duration",
          "eventCount",
          "dimensions",
          "timeout",
          "creditsUsed",
          "websocketUrl",
          "debugUrl",
          "debuggerUrl",
          "sessionViewerUrl",
          "noVncUrl",
          "proxyTxBytes",
          "proxyRxBytes",
          "proxyTraffic"
        ],
        "additionalProperties": false
