  "components": {
    "schemas": {
      "CreateSession": {
        "title": "CreateSession",
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "site": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "caller": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
          },
          "residential": {
            "type": "object",
            "properties": {
              "country": {
                "default": "US",
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              }
            },
            "additionalProperties": false
          },
          "targetUrl": {
            "type": "string",
            "format": "uri"
          },
          "proxyProfile": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "proxyLeaseId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "splitTraffic": {
            "default": false,
            "type": "boolean"
          },
          "budgetBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          },
          "mode": {
            "default": "agent",
            "type": "string",
            "enum": [
              "agent",
              "quiet"
            ]
          },
          "identity": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
          },
          "profile": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
          },
          "proxyUrl": {
            "type": "string",
            "format": "uri"
          },
          "timezone": {
            "type": "string"
          },
          "locale": {
            "default": "en-US",
            "type": "string",
            "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
          },
          "headless": {
            "type": "boolean"
          },
          "blockAds": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "dimensions": {
            "type": "object",
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 320,
                "maximum": 3840
              },
              "height": {
                "type": "integer",
                "minimum": 240,
                "maximum": 2160
              }
            },
            "required": [
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          "sessionContext": {
            "type": "object",
            "properties": {
              "cookies": {
                "description": "Cookies to initialize in the session",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "The name of the cookie"
                    },
                    "value": {
                      "type": "string",
                      "description": "The value of the cookie"
                    },
                    "url": {
                      "description": "The URL of the cookie",
                      "type": "string"
                    },
                    "domain": {
                      "description": "The domain of the cookie",
                      "type": "string"
                    },
                    "path": {
                      "description": "The path of the cookie",
                      "type": "string"
                    },
                    "secure": {
                      "description": "Whether the cookie is secure",
                      "type": "boolean"
                    },
                    "httpOnly": {
                      "description": "Whether the cookie is HTTP only",
                      "type": "boolean"
                    },
                    "sameSite": {
                      "description": "The same site attribute of the cookie",
                      "type": "string",
                      "enum": [
                        "Strict",
                        "Lax",
                        "None"
                      ]
                    },
                    "size": {
                      "description": "The size of the cookie",
                      "type": "number"
                    },
                    "expires": {
                      "description": "The expiration date of the cookie",
                      "type": "number"
                    },
                    "partitionKey": {
                      "description": "The partition key of the cookie",
                      "type": "object",
                      "properties": {
                        "topLevelSite": {
                          "type": "string",
                          "description": "The site of the top-level URL the browser was visiting at the start of the request to the endpoint that set the cookie."
                        },
                        "hasCrossSiteAncestor": {
                          "type": "boolean",
                          "description": "Indicates if the cookie has any ancestors that are cross-site to the topLevelSite."
                        }
                      },
                      "required": [
                        "topLevelSite",
                        "hasCrossSiteAncestor"
                      ],
                      "additionalProperties": false
                    },
                    "session": {
                      "description": "Whether the cookie is a session cookie",
                      "type": "boolean"
                    },
                    "priority": {
                      "description": "The priority of the cookie",
                      "type": "string",
                      "enum": [
                        "Low",
                        "Medium",
                        "High"
                      ]
                    },
                    "sameParty": {
                      "description": "Whether the cookie is a same party cookie",
                      "type": "boolean"
                    },
                    "sourceScheme": {
                      "description": "The source scheme of the cookie",
                      "type": "string",
                      "enum": [
                        "Unset",
                        "NonSecure",
                        "Secure"
                      ]
                    },
                    "sourcePort": {
                      "description": "The source port of the cookie",
                      "type": "number"
                    }
                  },
                  "required": [
                    "name",
                    "value"
                  ],
                  "additionalProperties": false
                }
              },
              "localStorage": {
                "description": "Domain-specific localStorage items to initialize in the session",
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "sessionStorage": {
                "description": "Domain-specific sessionStorage items to initialize in the session",
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "indexedDB": {
                "description": "Legacy context field; named profiles preserve IndexedDB, but context injection does not restore it",
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "number"
                      },
                      "name": {
                        "type": "string"
                      },
                      "data": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "number"
                            },
                            "name": {
                              "type": "string"
                            },
                            "records": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "key": {},
                                  "value": {},
                                  "blobFiles": {
                                    "type": "array",
                                    "items": {
                                      "type": "object",
                                      "properties": {
                                        "blobNumber": {
                                          "type": "number"
                                        },
                                        "mimeType": {
                                          "type": "string"
                                        },
                                        "size": {
                                          "type": "number"
                                        },
                                        "filename": {
                                          "type": "string"
                                        },
                                        "lastModified": {
                                          "type": "string",
                                          "format": "date-time"
                                        },
                                        "path": {
                                          "type": "string"
                                        }
                                      },
                                      "required": [
                                        "blobNumber",
                                        "mimeType",
                                        "size"
                                      ],
                                      "additionalProperties": false
                                    }
                                  }
                                },
                                "additionalProperties": false
                              }
                            }
                          },
                          "required": [
                            "id",
                            "name",
                            "records"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "id",
                      "name",
                      "data"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            },
            "additionalProperties": false
          },
          "connection": {
            "type": "string",
            "pattern": "^(?:browser|vault|api):[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
