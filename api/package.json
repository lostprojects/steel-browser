{
  "name": "@toolstack/api",
  "version": "0.5.3",
  "type": "module",
  "private": true,
  "exports": {
    "./plugin": {
      "import": {
        "types": "./build/toolstack-plugin.d.ts",
        "default": "./build/toolstack-plugin.js"
      }
    },
    "./cdp-plugin": {
      "import": {
        "types": "./build/services/cdp/plugins/core/base-plugin.d.ts",
        "default": "./build/services/cdp/plugins/core/base-plugin.js"
      }
    },
    "./logger": {
      "import": {
        "types": "./build/services/cdp/instrumentation/browser-logger.d.ts",
        "default": "./build/services/cdp/instrumentation/browser-logger.js"
      }
    },
    "./storage": {
      "import": {
        "types": "./build/services/cdp/instrumentation/storage/log-storage.interface.d.ts",
        "default": "./build/services/cdp/instrumentation/storage/log-storage.interface.js"
      }
    },
    "./browser": {
      "import": {
        "types": "./build/types/browser.d.ts",
        "default": "./build/types/browser.js"
      }
    },
    "./operations": {
      "import": {
        "types": "./build/services/operations.d.ts",
        "default": "./build/services/operations.js"
      }
    }
  },
  "scripts": {
    "start": "node ./build/start.js",
    "build": "rm -rf build && tsc && npm run copy:templates",
    "copy:templates": "mkdir -p build/templates && cp -r src/templates/* build/templates/",
    "package:gateway": "node scripts/package-gateway.mjs",
    "dev": "tsx watch src/start.ts",
    "test": "vitest run",
    "test:heavy": "SCRAPE_EVAL_HEAVY=1 vitest run",
    "eval:report": "tsx src/utils/scrape/__tests__/eval/runEval.ts",
    "pretty": "prettier --write \"src/**/*.ts\"",
    "generate:openapi": "tsx ./openapi/generate.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "verify:application": "node scripts/verify-application.mjs",
    "test:library": "node scripts/test-library.mjs",
    "provision:library": "node scripts/provision-library.mjs",
    "configure:library": "node scripts/configure-library.mjs",
    "cleanup:library": "node scripts/cleanup-library.mjs",
    "verify:library": "node scripts/test-library.mjs --ui",
    "verify:cloud-library": "node scripts/verify-cloud-library.mjs",
    "test:jobs": "node scripts/test-library.mjs --jobs",
    "package:jobs": "node scripts/package-gateway.mjs --jobs"
  },
  "author": "Nasr Mohamed",
  "devDependencies": {
    "@aws-sdk/client-iam": "^3.1164.0",
    "@types/archiver": "^8.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "jsdom": "^31.0.0",
    "pino-pretty": "^13.2.0",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@fastify/cors": "^11.4.1",
    "@fastify/multipart": "^10.1.7",
    "@fastify/static": "^10.1.10",
    "@fastify/swagger": "^9.9.3",
    "@fastify/view": "12.0.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "archiver": "^8.0.0",
    "cheerio": "^1.2.0",
    "defuddle": "^0.19.6",
    "devtools-protocol": "0.0.1704951",
    "ejs": "^7.0.2",
    "express": "5.3.0",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "mime-types": "^3.0.2",
    "mupdf": "^1.28.1",
    "pg-boss": "12.38.1",
    "postgres": "^4.1.0",
    "proxy-chain": "^3.0.1",
    "puppeteer-core": "npm:rebrowser-puppeteer-core@25.16.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  }
}
